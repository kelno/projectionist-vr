{
  "name": "projectionist-vr",
  "version": "1.15.6",
  "description": "Self-hosted WebXR player: stream your own VR videos from your server to your headset's browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/kelno/projectionist-vr.git"
  },
  "scripts": {
    "build": "webpack --config webpack.config.cjs --env production",
    "build-dev": "webpack --config webpack.config.cjs --env development",
    "dev": "webpack serve --config webpack.config.cjs --env development",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:py": "uv run python -m unittest discover --start-directory scripts/tests --quiet",
    "lint:py": "uv run ruff check && uv run ruff format --check && uv run basedpyright",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run lint:py && npm run test:py"
  },
  "author": "kelno",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@pmndrs/uikit": "^1.0.78",
    "@preact/signals-core": "^1.14.5",
    "@types/three": "^0.185.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@material-symbols/svg-600": "^0.49.0",
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "file-loader": "^6.2.0",
    "globals": "^17.14.0",
    "html-webpack-plugin": "^5.6.8",
    "prettier": "^3.10.1",
    "smol-toml": "^1.9.1",
    "stats.js": "^0.17.0",
    "ts-loader": "^9.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  }
}
